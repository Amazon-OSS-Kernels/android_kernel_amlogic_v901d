if TARGET_MESON_TM2

config SYS_CPU
	string
	default "armv8"

config SYS_BOARD
	string
	default "lagunaf"

config SYS_VENDOR
	string
	default "amlogic"

config SYS_SOC
	string
	default "tm2"

config SYS_CONFIG_NAME
	default "lagunaf"

config MTK_BT_USB
    bool "enable mtk bt usb function"
    default n
    help
        select this item will enable mtk bt usb device

config FASTBOOT_SLOT_SWITCHING
	bool "enable switching active_slots using fastboot"
	default n
	help
		select this item will enable fastboot active_slot switching

endif
